# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
*.ipr
*.iws
.vscode/

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Keystore files
*.jks
*.keystore

# IrisShell: commit the debug.keystore so every installer (CI + local) signs
# with the same key. Otherwise CI-built APKs cannot be installed over locally-
# built APKs without uninstalling first. Release keystores are NEVER tracked.
!app/keystore/debug.keystore
!keystore/debug.keystore
!keystore.properties


# Misc
.DS_Store
Thumbs.db

# Profile .hprof files
*.hprof

# Secrets / API keys — never commit
secrets.properties
*.keystore.pem
*.key.pem
*.pem

# Native libs decrypted at runtime
!gradle/wrapper/gradle-wrapper.jar

# Local junk that does not belong in the repository
.recycle/
bug.jpg

# HTML prototypes and design mockups live outside the repo, in the design
# vault (MuhofyBox/Drosh/). Ignored so a download or an old checkout cannot
# put them back.
html/

# Android file manager's recycle bin, dropped into the working tree when
# something is deleted from the device. Metadata records, not source — and it
# shows up as untracked on every run that deleted a file.
.recycle/

# i18n staging: prepared translations, already merged into values-XX/
docs/tmp-translations-only-the-missing/

# The Rust engine workspace (engine/rust) — built only in CI.
engine/rust/target/
# The cross-built core arrives from CI as an artifact, never from git.
engine/src/main/jniLibs/

# libchrootng.so is cross-built from the chroot-ng submodule in CI and copied
# into terminal's jniLibs; it is never committed (libtermux.so is a prebuilt
# and stays tracked).
terminal/src/main/jniLibs/arm64-v8a/libchrootng.so
