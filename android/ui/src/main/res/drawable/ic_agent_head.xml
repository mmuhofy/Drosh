<?xml version="1.0" encoding="utf-8"?>
<!--
  Agent mark — a head with a face.

  Replaces a terminal window with "> _" cut out of it. That was a deliberate
  attempt at one image saying both "agent" and "looking at a shell", and it
  failed for the reason it was drawn: the shell is the *thing the agent uses*,
  not what the agent *is*, and a "> _" face is the glyph every terminal in the
  app already uses. Putting it on the agent button made one icon mean "shell"
  and "agent" at once, so the two could not be told apart at a glance — which is
  the exact confusion the mark existed to prevent.

  So it is a face now: rounded square skull, two eyes, an antenna. Nothing on it
  is a prompt character, so it cannot be misread as a terminal, and nothing is a
  mascot either — it is a head, which is the thing it is.

  Where it appears is the other half of the fix: this mark is on the terminal
  screen's agent button and nowhere else. It is not in settings and it is not in
  the chat header, because a screen that says "Agent" in words does not also need
  an icon claiming to say it.

  Stroked rather than solid. A solid head with two eye holes reads as a face at
  22dp but turns into a blob at 14dp, and this is used at both sizes. Strokes and
  fills both take the Icon() ColorFilter, so one tint drives the whole mark —
  which the previous evenOdd cut-out approach could not do without collapsing to
  flat colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Antenna stalk -->
    <path
        android:pathData="M12,3.4 V6"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round" />

    <!-- Antenna tip -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.8,2.7 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z" />

    <!-- Skull: rounded square, 4dp corners on a 24 viewport -->
    <path
        android:pathData="M8,6 H20 A4,4 0 0 1 24,10 V16 A4,4 0 0 1 20,20 H8 A4,4 0 0 1 4,16 V10 A4,4 0 0 1 8,6 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:fillColor="#00000000" />

    <!-- Eyes -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8.1,13.1 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M13.1,13.1 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" />
</vector>
