<?xml version="1.0" encoding="utf-8"?>
<!--
  Drosh launcher icon — monochrome layer (Android 13+ themed icons).

  This is an alpha mask: Android ignores these colours and paints the themed
  tint where a pixel is opaque. So the head is a ring and the prompt is a gap
  inside it — drawing a solid head and painting the prompt on top would make
  one opaque blob, and the prompt would vanish.

  Geometry matches ic_launcher_foreground.xml exactly, including the 0.79
  scale, so a themed icon and a colour icon are the same mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.79"
        android:scaleY="0.79"
        android:translateY="5.8">

        <!-- Antennas -->
        <path
            android:pathData="M45,41 C42.5,35 40,29 38.5,26"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4.2"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"/>

        <path
            android:pathData="M63,41 C65.5,35 68,29 69.5,26"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4.2"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"/>

        <!-- Head as an outline -->
        <path
            android:pathData="M22.5,55 A31.5,31.5 0,0 1,85.5 55 V70 A7,7 0,0 1,78 77 H33 A7,7 0,0 1,26 70 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="5.2"
            android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent"/>

        <!-- Eyes as the prompt, inside the outline -->
        <path
            android:pathData="M38,49 L49,58.5 L38,68"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="5.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent"/>

        <path
            android:pathData="M57,62.5 L71,62.5"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="5.2"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"/>

    </group>

</vector>
