<?xml version="1.0" encoding="utf-8"?>
<!--
  Drosh launcher icon — foreground.

  An Android head whose eyes are a terminal prompt. The geometry is the
  mascot's, not an approximation: dome radius on the y=55 line, body
  extended to a rounded base, antennas rising from the dome at the platform's
  angle. Source of truth for the drawing is docs/icon/android-head.svg — this
  file is that drawing as a vector.

  ## Why the eyes are `>_`

  The Android head's eyes are the one feature that makes it a face. Replacing
  them with a chevron and a cursor bar — on the eye line, in the eye slots —
  keeps the face while saying what the app is: a shell waiting for a command.
  Drawing the cursor lower, at a mouth position, would have given the head two
  features where the mascot has one, and the face would stop reading as Android.

  Both are cut in #0B2115 — the same colour as the icon's background — rather
  than painted in a second green: the prompt reads as a hole in the head, and a
  hole survives the monochrome tint that flattens two fills into one.

  ## The group

  108dp is the canvas, not the icon. A launcher draws a mask over it, and the
  safe area is a circle of radius 33 about (54,54). As authored, the antenna
  tips reach 41 from the centre and the base corners 35, so a circular launcher
  cut them. The group scales the whole drawing to 0.79 — farthest point 31.5 —
  and pivots on the drawing's own optical centre rather than the canvas centre,
  because the head's mass sits above 54 and pivoting on 54 is what made an
  earlier attempt read as "sitting too high".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.79"
        android:scaleY="0.79"
        android:translateY="5.8">

        <!-- Antennas -->
        <path
            android:pathData="M45,41 C42.5,35 40,29 38.5,26"
            android:strokeColor="#3DDC84"
            android:strokeWidth="4.2"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"/>

        <path
            android:pathData="M63,41 C65.5,35 68,29 69.5,26"
            android:strokeColor="#3DDC84"
            android:strokeWidth="4.2"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"/>

        <!-- Head -->
        <path
            android:pathData="M22.5,55 A31.5,31.5 0,0 1,85.5 55 V70 A7,7 0,0 1,78 77 H33 A7,7 0,0 1,26 70 Z"
            android:fillColor="#3DDC84"/>

        <!-- Eyes as the prompt -->
        <path
            android:pathData="M38,49 L49,58.5 L38,68"
            android:strokeColor="#0B2115"
            android:strokeWidth="5.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent"/>

        <path
            android:pathData="M57,62.5 L71,62.5"
            android:strokeColor="#0B2115"
            android:strokeWidth="5.2"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"/>

    </group>

</vector>
