<?xml version="1.0" encoding="utf-8"?>
<!--
  App entry-point manifest.
  
  Per AGENT.md §109: Hilt, Navigation, MainActivity live here.
  Per AGENT.md §404: native lib (libtermux.so) loaded from :terminal module.
  
  Declared permissions / features are minimal for the project setup commit.
  Each phase will add or relax permissions as needed (foreground service for
  persistent terminal sessions, biometric for SSH key vault, notifications for
  command finished events, etc.).

  No Application / Activity classes are declared at this commit - those are
  introduced in Phase 1 alongside the first real UI surface.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Minimal baseline permissions — Phase 1 only. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Lets Drosh Keyboard read the terminal's command state. Signature-level
      means only a build signed with the same key qualifies, which both apps
      are — that shared identity is the whole reason this is possible.
    -->
    <permission
        android:name="dev.drosh.permission.READ_COMMAND_STATE"
        android:protectionLevel="signature"
        android:label="@string/permission_read_command_state_label"
        android:description="@string/permission_read_command_state_description" />

    <!-- Senders of the keyboard window-mode broadcast. Signature-level for the
         same reason as above: only the Drosh Keyboard build may tell Drosh
         where it is docked. -->
    <permission
        android:name="dev.drosh.permission.SEND_KEYBOARD_MODE"
        android:protectionLevel="signature"
        android:label="@string/permission_send_keyboard_mode_label"
        android:description="@string/permission_send_keyboard_mode_description" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- The floating pane is a window above other apps, which needs the user's
         explicit grant; it is checked at runtime, never assumed. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Drosh targets Android 8.0+ but is optimized for Android 16. -->
    <uses-feature
        android:name="android.software.terminal"
        android:required="false" />

    <application
        android:name=".DroshApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Drosh"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TerminalService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".ui.overlay.FloatingPaneOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-initiated terminal pane on screen while the user works in another app." />
        </service>

        <provider
            android:name=".DroshDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!--
          Read-only command state for Drosh Keyboard. exported so the keyboard
          can query it, and gated by the signature permission above so that
          only the same-signed keyboard gets through.
        -->
        <provider
            android:name="dev.drosh.data.state.CommandStateProvider"
            android:authorities="dev.drosh.state"
            android:exported="true"
            android:grantUriPermissions="false"
            android:permission="dev.drosh.permission.READ_COMMAND_STATE" />
    </application>

</manifest>
