<?xml version="1.0" encoding="utf-8"?>
<!--
  App theme — Drosh, dark only (v1.0).
  The Compose layer carries real palette + typography tokens (see
  dev.drosh.ui.theme.DroshTheme). This XML only handles the bits
  Compose cannot paint from inside the activity: the system status bar and
  navigation bar, and the launcher icon surface.

  Status / navigation bar: matched to DroshSurface (#0A0A0A) so the chrome
  creates a subtle depth layer above the OLED black terminal. This avoids
  the status bar bleeding into the terminal content — a sliver of #0A0A0A
  gives the system bar a visible edge without adding visual noise.
-->
<resources>
    <style name="Theme.Drosh" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#FF0A0A0A</item>
        <item name="android:navigationBarColor">#FF0A0A0A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!--
          Required for the immersive chrome to work: the app draws into the display
          cutout so that hiding the system bars can actually move content to the
          top of the screen.

          With the default mode Android only permits the window to extend into the
          cutout while the status bar is requested visible — AOSP's
          WindowLayout.java gates the exemption on `requestedVisibleTypes`. So
          hiding the bars withdraws the permission, the window is letterboxed to
          the cutout-safe area, and `offset = 0.dp` still does not put anything at
          the top of the screen. Google's own guidance for anything transitioning
          in and out of immersive mode is to set `always`.

          Not the default here: this project is targetSdk 28, so the SDK-35
          reinterpretation of DEFAULT as ALWAYS does not apply.

          The consequence is that content may draw under the notch, which the
          terminal's constant top clearance already accounts for.
        -->
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
