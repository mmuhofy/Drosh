<?xml version="1.0" encoding="utf-8"?>
<!--
  App theme — Drosh, dark only (v1.0).
  The Compose layer carries real palette + typography tokens (see
  com.iris.irisshell.ui.theme.DroshTheme). This XML only handles the bits
  Compose cannot paint from inside the activity: the system status bar and
  navigation bar, and the launcher icon surface.

  Status / navigation bar: matched to DroshSurface (#0A0A0A) so the chrome
  creates a subtle depth layer above the OLED black terminal. This avoids
  the status bar bleeding into the terminal content — a sliver of #0A0A0A
  gives the system bar a visible edge without adding visual noise.
-->
<resources>
    <style name="Theme.Drosh" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#FF0A0A0A</item>
        <item name="android:navigationBarColor">#FF0A0A0A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
